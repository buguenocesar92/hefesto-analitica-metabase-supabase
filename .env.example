# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
COMPOSE_PROJECT_NAME=hefesto-analitica
BI_HOST=analitica.tu-dominio.cl
POSTGRES_HOST=db.REEMPLAZAR.supabase.co
POSTGRES_USERNAME=metabase_app
POSTGRES_PASSWORD=GENERAR
MB_ENCRYPTION_SECRET_KEY=GENERAR
SUPABASE_DEDICATED_CONFIRMED=true
SUPABASE_DATA_API_DISABLED=true
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_PASSWORD=GENERAR
DB_SSLMODE=require
DB_SSLROOTCERT=/run/supabase/ca.crt
INITIAL_SETUP_COMPLETE=false
APP_URL=https://analitica.tu-dominio.cl
APP_HOST=analitica.tu-dominio.cl
